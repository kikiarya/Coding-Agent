{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-agent-policy.local/schemas/episode_record.schema.json",
  "title": "EpisodeRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "episode_id", "task_id", "split", "repo_id",
    "model_id", "adapter_id", "experiment_config_hash", "seed",
    "termination_reason", "resolved", "environment_valid", "total_steps",
    "total_input_tokens", "total_output_tokens", "test_calls", "patch_groups",
    "verified_patch_groups", "duplicate_actions", "invalid_actions",
    "recovery_opportunities", "recovered_episodes", "final_diff_hash",
    "evaluator_artifact", "initial_evaluator_artifact",
    "initial_fail_to_pass_count", "best_fail_to_pass_count", "wall_time_ms"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["smoke", "train", "dev", "test", "external"]},
    "repo_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "adapter_id": {"type": ["string", "null"]},
    "experiment_config_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "seed": {"type": "integer"},
    "termination_reason": {"type": "string", "minLength": 1},
    "resolved": {"type": "boolean"},
    "environment_valid": {"type": "boolean"},
    "total_steps": {"type": "integer", "minimum": 0},
    "total_input_tokens": {"type": "integer", "minimum": 0},
    "total_output_tokens": {"type": "integer", "minimum": 0},
    "test_calls": {"type": "integer", "minimum": 0},
    "patch_groups": {"type": "integer", "minimum": 0},
    "verified_patch_groups": {"type": "integer", "minimum": 0},
    "duplicate_actions": {"type": "integer", "minimum": 0},
    "invalid_actions": {"type": "integer", "minimum": 0},
    "recovery_opportunities": {"type": "integer", "minimum": 0},
    "recovered_episodes": {"type": "integer", "minimum": 0},
    "final_diff_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evaluator_artifact": {"type": "string", "minLength": 1},
    "initial_evaluator_artifact": {"type": "string", "minLength": 1},
    "initial_fail_to_pass_count": {"type": ["integer", "null"], "minimum": 0},
    "best_fail_to_pass_count": {"type": ["integer", "null"], "minimum": 0},
    "wall_time_ms": {"type": "integer", "minimum": 0},
    "attempt_id": {"type": ["string", "null"]},
    "parent_episode_id": {"type": ["string", "null"]},
    "resumed_from_step": {"type": ["integer", "null"], "minimum": 0}
  }
}
