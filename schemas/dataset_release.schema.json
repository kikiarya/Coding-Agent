{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-agent-policy.local/schemas/dataset_release.schema.json",
  "title": "DatasetReleaseManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_type", "generator_version", "dataset",
    "dataset_path", "dataset_sha256", "task_manifest_path",
    "task_manifest_sha256", "replay_ledger_path", "replay_ledger_sha256",
    "sample_count", "category_counts", "correction_counts", "review_counts",
    "split_counts", "source_run_ids", "sample_hashes", "validation", "valid"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "report_type": {"const": "dataset_release_manifest"},
    "generator_version": {"const": "dataset_release_v1"},
    "dataset": {"enum": ["D_success", "D_policy"]},
    "dataset_path": {"type": "string", "minLength": 1},
    "dataset_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "task_manifest_path": {"type": "string", "minLength": 1},
    "task_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "replay_ledger_path": {"type": ["string", "null"]},
    "replay_ledger_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "sample_count": {"type": "integer", "minimum": 1},
    "category_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "correction_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "review_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "split_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "source_run_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sample_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample_id", "provenance_hash", "content_hash"],
        "properties": {
          "sample_id": {"type": "string", "minLength": 1},
          "provenance_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "validation": {"type": "object"},
    "valid": {"const": true}
  }
}
