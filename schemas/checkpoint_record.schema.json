{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-agent-policy.local/schemas/checkpoint_record.schema.json",
  "title": "CheckpointRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "episode_id",
    "task_id",
    "step_index",
    "next_step_index",
    "state_hash_after",
    "diff_hash",
    "observation_hash",
    "replayable"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "step_index": {
      "type": "integer",
      "minimum": 0
    },
    "next_step_index": {
      "type": "integer",
      "minimum": 1
    },
    "state_hash_after": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "diff_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observation_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "replayable": {
      "type": "boolean"
    },
    "state_contract": {
      "const": "workspace-v1"
    },
    "recovery_state": {
      "type": "object"
    },
    "recovery_state_ref": {
      "type": "string", "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "budget_used": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "input_tokens",
        "output_tokens",
        "test_calls",
        "elapsed_seconds"
      ],
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "test_calls": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
