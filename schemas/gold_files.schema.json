{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-agent-policy.local/schemas/gold_files.schema.json",
  "title": "GoldFilesEntry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "gold_files"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "task_id": {"type": "string", "minLength": 1},
    "gold_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
