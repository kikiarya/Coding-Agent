{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-agent-policy.local/schemas/swe_smith_oracle.schema.json",
  "title": "SweSmithOracleEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "patch", "gold_files", "fail_to_pass", "pass_to_pass"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "task_id": {"type": "string", "minLength": 1},
    "patch": {"type": "string", "minLength": 1},
    "gold_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "fail_to_pass": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "pass_to_pass": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
